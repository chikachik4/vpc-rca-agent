AWS_REGION=ap-northeast-2
EKS_CLUSTER_NAME=bookjjeok-cloud-eks-cluster
REDIS_HOST=localhost
REDIS_PORT=6379

# VPC3 Observability (monitoring hub)
PROMETHEUS_URL=http://<vpc3-monitoring-ip>:9090
TEMPO_URL=http://<vpc3-monitoring-ip>:3200
ARGOCD_URL=https://<vpc3-argocd-ip>:32346
ARGOCD_TOKEN=<argocd-api-token>
OPENSEARCH_URL=https://<aws-opensearch-endpoint>:443

TLS_VERIFY=true
# TLS_VERIFY=false  # 내부 자체서명 인증서 사용 환경에서만
CA_BUNDLE_PATH=
REQUEST_TIMEOUT_SECONDS=10.0
MCP_CONFIG_PATH=mcp_config.json

# LLM 모델 (Bedrock)
LLM_MODEL_EXPERT=anthropic.claude-3-5-sonnet-20240620-v1:0
LLM_MODEL_ROUTING=anthropic.claude-3-haiku-20240307-v1:0

# ObserverLoop — 폴링 간격
OBSERVER_INTERVAL_SEC=15

# ObserverLoop — 임계값 (기본값으로 대부분 충분)
CPU_ALERT_THRESHOLD=0.5
BACKEND_CPU_CORES_THRESHOLD=0.1
POD_RESTART_THRESHOLD=3
OOMKILL_THRESHOLD=0
MEMORY_UTILIZATION_THRESHOLD=80
BACKEND_READY_REPLICAS_THRESHOLD=2
REDIS_MISS_RATE_THRESHOLD=0.1
DB_CONN_THRESHOLD=15
RESPONSE_TIME_THRESHOLD=0.1
ERROR_RATE_THRESHOLD=0.05

# ReportDispatcher
SLACK_WEBHOOK_URL=
REPORT_DIR=reports

# Logging (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
