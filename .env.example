AWS_REGION=ap-northeast-2
EKS_CLUSTER_NAME=bookjjeok-test-eks-cluster
REDIS_HOST=localhost
REDIS_PORT=6379

# VPC3 Observability
PROMETHEUS_URL=http://10.2.x.x:9090
ARGOCD_URL=https://10.2.x.x:443
ARGOCD_TOKEN=<argocd-api-token>
OPENSEARCH_URL=https://10.2.x.x:9200
TEMPO_URL=http://10.2.x.x:3200

TLS_VERIFY=true
CA_BUNDLE_PATH=
REQUEST_TIMEOUT_SECONDS=10.0
MCP_CONFIG_PATH=mcp_config.json

# LLM 모델 (Bedrock)
LLM_MODEL_EXPERT=anthropic.claude-3-5-sonnet-20240620-v1:0
LLM_MODEL_ROUTING=anthropic.claude-3-haiku-20240307-v1:0

# ObserverLoop — 폴링 간격
OBSERVER_INTERVAL_SEC=15

# ObserverLoop — 임계값 (기본값으로 대부분 충분)
CPU_ALERT_THRESHOLD=0.5
POD_RESTART_THRESHOLD=3
HEALTH_SCORE_THRESHOLD=80.0
REDIS_MISS_RATE_THRESHOLD=0.1
DB_CONN_THRESHOLD=15
RESPONSE_TIME_THRESHOLD=0.1
ERROR_RATE_THRESHOLD=0.05

# ReportDispatcher
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
REPORT_DIR=reports

# Logging (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
